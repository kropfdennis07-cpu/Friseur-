---
/**
 * Preise. Laut Fahrplan die Sektion, nach der wirklich gesucht wird.
 *
 * Bewusst keine Kästen mit Rahmen: Fünf gerahmte Kacheln nebeneinander
 * sehen aus wie ein Tarifvergleich. Hier stehen Gruppenname und Posten
 * in ruhigen Spalten, getrennt nur durch feine Linien — das liest sich
 * wie eine Preistafel im Salon, nicht wie ein Formular.
 */
import type { Salon } from "../lib/salon";

interface Props {
  salon: Salon;
}
const { salon } = Astro.props;
---

<section id="leistungen" class="scroll-mt-16 bg-grund">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:py-24">
    <div class="strich">
      <p class="dachzeile">Leistungen</p>
      <h2 class="titel mt-4 text-4xl sm:text-5xl">Was es kostet</h2>
      <p class="mt-4 max-w-xl text-lg text-text-leise">
        Alles ab-Preise. Was bei dir nötig ist, besprechen wir vorher — ohne
        Überraschung auf der Rechnung.
      </p>
    </div>

    <div class="mt-14 grid gap-x-16 gap-y-12 sm:grid-cols-2">
      {
        salon.leistungen.map((gruppe) => (
          <div>
            <h3 class="dachzeile border-b border-rand pb-3">{gruppe.gruppe}</h3>
            <dl class="mt-1">
              {gruppe.posten.map((posten) => (
                <div class="flex items-baseline justify-between gap-6 border-b border-rand py-3.5">
                  <dt class="text-lg">{posten.name}</dt>
                  <dd class="shrink-0 text-lg font-semibold tabular-nums">{posten.preis}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))
      }
    </div>
  </div>
</section>
