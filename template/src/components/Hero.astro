---
/**
 * Der Aufmacher.
 *
 * Zwei Spalten: links das Wort, rechts das Bild. Fehlt das Foto noch
 * (Lead-Vorschau, Kunde hat noch keinen Fototermin), tritt eine
 * Farbfläche mit der Initiale an seine Stelle — das sieht nach Absicht
 * aus statt nach Lücke.
 */
import type { Salon } from "../lib/salon";
import { telLink, telefonText, terminZiel, heroBild } from "../lib/salon";

interface Props {
  salon: Salon;
}
const { salon } = Astro.props;
const termin = terminZiel(salon);
const bild = heroBild(salon);
const initiale = salon.name.replace(/^(salon|friseur|coiffeur)\s+/i, "").trim().charAt(0).toUpperCase();
---

<section class="relative overflow-hidden bg-grund">
  <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 sm:py-20 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
    <div>
      <p class="dachzeile">Friseur in {salon.adresse.ort}</p>

      <h1 class="titel mt-5 text-5xl sm:text-6xl lg:text-7xl">
        {salon.name}
      </h1>

      <p class="mt-6 max-w-xl text-xl leading-relaxed text-text-leise sm:text-2xl">
        {salon.claim}
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={termin.href}
          rel={termin.extern ? "noopener" : undefined}
          target={termin.extern ? "_blank" : undefined}
          class="rounded-eigen bg-akzent px-8 py-4 text-center text-base font-semibold text-akzent-text transition hover:opacity-90"
        >
          {termin.text}
        </a>

        <a
          href={telLink(salon.kontakt)}
          class="rounded-eigen border border-text px-8 py-4 text-center text-base font-semibold transition hover:bg-text hover:text-grund"
        >
          {telefonText(salon.kontakt)}
        </a>
      </div>

      {
        salon.termin.hinweis && (
          <p class="mt-4 text-sm text-text-leise">{salon.termin.hinweis}</p>
        )
      }
    </div>

    <div class="relative">
      {
        bild ? (
          <img
            src={bild.src}
            alt={bild.alt}
            width="900"
            height="1100"
            class="aspect-[4/5] w-full rounded-eigen object-cover"
            fetchpriority="high"
          />
        ) : (
          <div
            class="flex aspect-[4/5] w-full items-center justify-center rounded-eigen bg-grund-satt"
            aria-hidden="true"
          >
            <span
              class="titel text-[10rem] leading-none text-akzent-text opacity-90 sm:text-[14rem]"
              style="color: var(--t-grund)"
            >
              {initiale}
            </span>
          </div>
        )
      }
    </div>
  </div>
</section>
