---
import type { Salon } from "../lib/salon";
import { telLink, telefonText, terminZiel } from "../lib/salon";

interface Props {
  salon: Salon;
}
const { salon } = Astro.props;
const termin = terminZiel(salon);
---

<section class="border-b border-rand bg-grund-sanft">
  <div class="mx-auto max-w-5xl px-4 py-14 sm:py-20">
    <p class="text-sm font-semibold uppercase tracking-widest text-akzent">
      Friseur in {salon.adresse.ort}
    </p>

    <h1 class="mt-3 font-titel text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
      {salon.name}
    </h1>

    <p class="mt-4 max-w-2xl text-lg text-text-leise sm:text-xl">
      {salon.claim}
    </p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href={termin.href}
        rel={termin.extern ? "noopener" : undefined}
        target={termin.extern ? "_blank" : undefined}
        class="rounded-eigen bg-akzent px-6 py-4 text-center text-base font-semibold text-akzent-text hover:opacity-90"
      >
        {termin.text}
      </a>

      <a
        href={telLink(salon.kontakt)}
        class="rounded-eigen border-2 border-akzent px-6 py-4 text-center text-base font-semibold text-akzent hover:bg-akzent hover:text-akzent-text"
      >
        {telefonText(salon.kontakt)}
      </a>
    </div>

    {
      salon.termin.hinweis && (
        <p class="mt-4 text-sm text-text-leise">{salon.termin.hinweis}</p>
      )
    }
  </div>
</section>
